<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Chautari keeps live audio going while the phone is locked or another
      app is open, as iOS does with its "audio" background mode. Android
      allows that only from a foreground service with a visible notification.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name="news.icn.audioservice.ChautariAudioService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback|microphone" />
    </application>
</manifest>
