{
  "expo": {
    "name": "Inner Circle Nepal",
    "slug": "inner-circle-nepal",
    "scheme": "icn",
    "version": "1.3.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "news.icn.mobile",
      "associatedDomains": [
        "applinks:icn.news"
      ],
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification",
          "audio"
        ],
        "NSMicrophoneUsageDescription": "Inner Circle Nepal uses your microphone only when you speak in a Chautari live conversation. Listeners are never recorded.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bitcode": false
    },
    "android": {
      "package": "news.icn.mobile",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#fbfaf7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "icn.news",
              "pathPrefix": "/chautari/"
            },
            {
              "scheme": "https",
              "host": "icn.news",
              "pathPrefix": "/nepal/"
            },
            {
              "scheme": "https",
              "host": "icn.news",
              "pathPrefix": "/investigations/"
            },
            {
              "scheme": "https",
              "host": "icn.news",
              "pathPrefix": "/diaspora/"
            },
            {
              "scheme": "https",
              "host": "icn.news",
              "pathPrefix": "/immigration/"
            },
            {
              "scheme": "https",
              "host": "icn.news",
              "pathPrefix": "/nepse/"
            },
            {
              "scheme": "https",
              "host": "icn.news",
              "pathPrefix": "/technology/"
            },
            {
              "scheme": "https",
              "host": "icn.news",
              "pathPrefix": "/culture/"
            },
            {
              "scheme": "https",
              "host": "icn.news",
              "pathPrefix": "/sports/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH",
        "android.permission.CAMERA",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "largeIcon": "./assets/notification-large-icon.png",
          "color": "#db0a12",
          "defaultChannel": "breaking-news"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Inner Circle Nepal uses your photo library only when you choose a profile picture. Nothing is uploaded until you pick one.",
          "cameraPermission": "Inner Circle Nepal does not use your camera. Chautari's live audio library can also carry video, so iOS asks the app to describe camera access, but the app never turns the camera on.",
          "microphonePermission": "Inner Circle Nepal uses your microphone only when you speak in a Chautari live conversation. Listeners are never recorded."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "imageWidth": 180,
          "backgroundColor": "#fbfaf7",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#100f0d"
          }
        }
      ],
      "expo-image",
      "expo-web-browser",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# LiveKit / WebRTC (Chautari live audio).\n# R8 fails the release build without the first line. The rest are not\n# cosmetic: WebRTC's native layer resolves Java classes and methods through\n# JNI by name, so anything R8 strips or renames becomes an\n# UnsatisfiedLinkError or a silent null at runtime rather than a build\n# error. A minified build that starts and then has no audio is the failure\n# these prevent.\n-dontwarn livekit.org.jni_zero.**\n-keep class livekit.org.webrtc.** { *; }\n-keepclassmembers class livekit.org.webrtc.** { *; }\n-keep class org.webrtc.** { *; }\n-dontwarn org.webrtc.**\n"
          }
        }
      ],
      "./plugins/withOptionalHardware",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "197925ea-fcc7-42a1-9a87-aaa71d5b007e"
      }
    }
  }
}
