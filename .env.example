# ============================================================================
#  Inner Circle Nepal Mobile — Public Client Environment Variables
#  Copy to .env and fill in values from the website's public configuration.
#  Never place server secrets (such as SUPABASE_SERVICE_ROLE_KEY,
#  CLERK_SECRET_KEY, RESEND_API_KEY, or VAPID_PRIVATE_KEY) in this file.
# ============================================================================

# Canonical website origin used for sharing, deep-link validation, and public API routes
EXPO_PUBLIC_SITE_URL=https://icn.news

# Public Supabase endpoint and anon key (protected by Postgres Row-Level Security)
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Clerk publishable key — the SAME Clerk application the website uses, so an
# account made on icn.news works in the app and vice versa. Publishable by
# name and by nature: it identifies the application and is designed to ship in
# a client. The SECRET key stays on the website.
#
# Needed only for Chautari. Unset, the app hides the Chautari tab and
# everything else behaves exactly as before.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# NOTE: there is deliberately no LIVEKIT_API_SECRET here. The app never signs
# its own room tokens — it asks EXPO_PUBLIC_SITE_URL/api/chautari/token and
# the website mints a short-lived one after checking the Clerk session. A
# LiveKit secret in this file would be readable in the APK.

# ============================================================================
#  Only EXPO_PUBLIC_* belongs in this file
# ============================================================================
#  Every variable here is compiled into the APK and can be read out of it with
#  a text editor. Nothing secret may be added, whatever its name — a key that
#  is not prefixed is simply ignored by Metro, which makes it easy to believe
#  it is safely stored when it is only inert.
#
#  Server credentials (the Supabase service role, Clerk's secret key, the
#  LiveKit API secret) live in the WEBSITE's environment. The app asks
#  EXPO_PUBLIC_SITE_URL for anything that needs one.

